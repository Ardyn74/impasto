{
  "impasto": 1,
  "name": "Fuji",
  "wallpaper": "~/.local/share/wallpapers/pagoda-fuji-blossom.jpeg",
  "palette": "adaptive",
  "settings": {
    "barStyle": "grouped",
    "islandAttached": true,
    "barLeft": [
      "workspaces",
      "overview",
      "split",
      "launcher"
    ],
    "barRight": [
      "notifications",
      "network",
      "bluetooth",
      "volume",
      {
        "id": "battery",
        "figure": "on"
      }
    ],
    "chipShape": "icon",
    "chipFigure": "off",
    "clockFormat": "hh:mm AP",
    "desktopTheme": "modern",
    "desktopOpacity": 75,
    "desktopWidgets": [
      {
        "id": "clock",
        "family": "2x2",
        "col": 13,
        "row": 0,
        "key": "clock-13-0",
        "theme": "analogue"
      },
      {
        "id": "calendar",
        "family": "4x2",
        "col": 13,
        "row": 2,
        "key": "calendar-13-2"
      },
      {
        "id": "weather",
        "family": "2x2",
        "col": 13,
        "row": 4,
        "key": "weather-13-4"
      },
      {
        "id": "media",
        "family": "2x2",
        "col": 15,
        "row": 4,
        "key": "media-15-4"
      },
      {
        "id": "stats",
        "family": "4x2",
        "col": 13,
        "row": 6,
        "key": "stats-13-6"
      },
      {
        "id": "github",
        "family": "4x2",
        "col": 13,
        "row": 8,
        "key": "github-13-8"
      }
    ],
    "dockEdge": "bottom",
    "dockAutohide": false,
    "dockPinned": [
      "kitty.desktop",
      "org.gnome.Nautilus.desktop"
    ],
    "greeting": "koi",
    "wallpaperTransition": "circle",
    "keys": {
      "Applications · Open a terminal": "SUPER + Return",
      "Applications · Open the file manager": "SUPER + E",
      "Applications · Open the browser": "SUPER + F",
      "Windows · Close the focused window": "SUPER + Q",
      "Windows · Kill the focused window": "SUPER + SHIFT + Q",
      "Windows · Full screen": "SUPER + ALT + F",
      "Windows · Full screen, from F11": "F11",
      "Windows · Float or tile the window": "SUPER + SHIFT + F",
      "Windows · Toggle pseudo-tiling": "SUPER + P",
      "Windows · Flip the split direction": "SUPER + J",
      "Windows · Cycle the layout": "SUPER + SHIFT + L",
      "Windows · Focus the window left": "SUPER + left",
      "Windows · Focus the window right": "SUPER + right",
      "Windows · Focus the window up": "SUPER + up",
      "Windows · Focus the window down": "SUPER + down",
      "Windows · Next window": "ALT + Tab",
      "Windows · Previous window": "ALT + SHIFT + Tab",
      "Windows · Move the window left": "SUPER + CTRL + left",
      "Windows · Move the window right": "SUPER + CTRL + right",
      "Windows · Move the window to the previous workspace": "SUPER + CTRL + up",
      "Windows · Move the window to the next workspace": "SUPER + CTRL + down",
      "Windows · Shrink window width": "SUPER + minus",
      "Windows · Expand window width": "SUPER + equal",
      "Windows · Shrink window height": "SUPER + SHIFT + minus",
      "Windows · Expand window height": "SUPER + SHIFT + equal",
      "Windows · Drag the window": "SUPER + mouse:272",
      "Windows · Resize the window": "SUPER + mouse:273",
      "Workspaces · Go to workspace 1": "SUPER + 1",
      "Workspaces · Move the window to workspace 1": "SUPER + SHIFT + 1",
      "Workspaces · Go to workspace 2": "SUPER + 2",
      "Workspaces · Move the window to workspace 2": "SUPER + SHIFT + 2",
      "Workspaces · Go to workspace 3": "SUPER + 3",
      "Workspaces · Move the window to workspace 3": "SUPER + SHIFT + 3",
      "Workspaces · Go to workspace 4": "SUPER + 4",
      "Workspaces · Move the window to workspace 4": "SUPER + SHIFT + 4",
      "Workspaces · Go to workspace 5": "SUPER + 5",
      "Workspaces · Move the window to workspace 5": "SUPER + SHIFT + 5",
      "Workspaces · Go to workspace 6": "SUPER + 6",
      "Workspaces · Move the window to workspace 6": "SUPER + SHIFT + 6",
      "Workspaces · Go to workspace 7": "SUPER + 7",
      "Workspaces · Move the window to workspace 7": "SUPER + SHIFT + 7",
      "Workspaces · Go to workspace 8": "SUPER + 8",
      "Workspaces · Move the window to workspace 8": "SUPER + SHIFT + 8",
      "Workspaces · Go to workspace 9": "SUPER + 9",
      "Workspaces · Move the window to workspace 9": "SUPER + SHIFT + 9",
      "Workspaces · Go to workspace 10": "SUPER + 0",
      "Workspaces · Move the window to workspace 10": "SUPER + SHIFT + 0",
      "Workspaces · Next workspace": "SUPER + mouse_down",
      "Workspaces · Previous workspace": "SUPER + mouse_up",
      "Media · Volume up": "XF86AudioRaiseVolume",
      "Media · Volume down": "XF86AudioLowerVolume",
      "Media · Mute output": "XF86AudioMute",
      "Media · Mute microphone": "XF86AudioMicMute",
      "Media · Brightness up": "XF86MonBrightnessUp",
      "Media · Brightness down": "XF86MonBrightnessDown",
      "Media · Mute microphone (Acer)": "XF86Launch6",
      "Media · Play or pause": "XF86AudioPlay",
      "Media · Play or pause, from the pause key": "XF86AudioPause",
      "Media · Next track": "XF86AudioNext",
      "Media · Previous track": "XF86AudioPrev",
      "Session · Session menu": "SUPER + X",
      "Session · Session menu, from CTRL + ALT + Delete": "CTRL + ALT + Delete",
      "Session · Session menu, from the power button": "XF86PowerOff",
      "Session · Lock the screen": "SUPER + L",
      "Session · Exit Hyprland": "SUPER + SHIFT + E",
      "Utilities · Turn the screen off or back on": "SUPER + SHIFT + D",
      "Utilities · Restart the shell": "SUPER + R",
      "Shell · Open the launcher": "SUPER + Space",
      "Shell · Open the control centre": "",
      "Shell · Open the workspace overview": "SUPER + Backspace",
      "Shell · Open the workspace overview, from TAB": "SUPER + TAB",
      "Shell · Open settings": "SUPER + comma",
      "Shell · Open appearance": "SUPER + T",
      "Shell · Open the palette": "SUPER + SHIFT + T",
      "Shell · Open system statistics": "SUPER + B",
      "Shell · Open the pet": "",
      "Shell · Open the games": "",
      "Shell · Open the notes": "SUPER + S",
      "Shell · Open the task board": "SUPER + K",
      "Shell · Open the media player": "SUPER + M",
      "Shell · Show every key": "SUPER + H",
      "Shell · Hide or show the bar": "SUPER + A",
      "Shell · Hide or show the desktop widgets": "SUPER + CTRL + W",
      "Shell · Turn game mode on or off": "SUPER + SHIFT + G",
      "Shell · Open the packages": "SUPER + I",
      "Shell · Open the virtual machines": "",
      "Shell · Open the clipboard history": "SUPER + C",
      "Shell · Pick an emoji": "SUPER + period",
      "Shell · Pick a colour off the screen": "SUPER + SHIFT + C",
      "Shell · Open the capture surface": "SUPER + SHIFT + S",
      "Shell · Capture a region": "Print",
      "Shell · Capture a region and annotate it": "SHIFT + Print",
      "Shell · Capture the whole screen": "SUPER + Print",
      "Shell · Capture a region and annotate it, from SUPER + SHIFT + Print": "SUPER + SHIFT + Print",
      "Shell · Capture a window": "",
      "Shell · Read a region as text": "",
      "Shell · Start or stop recording the screen": "SUPER + SHIFT + R"
    }
  }
}
